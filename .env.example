# ==============================================================================
# SECURESCAN AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT commit actual secrets to source control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Security & Sessions
JWT_SECRET=super-secret-jwt-key-change-me-in-production-min-32-chars-long
JWT_EXPIRES_IN=7d
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://securescan:securescan_secret@localhost:5432/securescan_dev?schema=public

# Queue & Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Provider Abstraction
AI_PROVIDER=mock
# Options: mock, openai, anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Object Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=securescan-artifacts
S3_USE_SSL=false

# Scanner Limits & Safe Defaults
SCANNER_MAX_REDIRECTS=5
SCANNER_REQUEST_TIMEOUT_MS=10000
SCANNER_MAX_RESPONSE_BYTES=5242880
SCANNER_CONCURRENCY=5

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Email Provider
EMAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=notifications@securescan.ai
